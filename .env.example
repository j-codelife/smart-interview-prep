# Copy to backend/.env and fill in real values. Never commit .env files.
# Variables are introduced as features land; the phase that adds each is noted.

# --- Server (Phase 2) ---
NODE_ENV=development
PORT=4000
# Origin the browser app is served from (used for CORS)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Database (Phase 2) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internship_tracker
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/internship_tracker_test

# --- Auth (Phase 3) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# --- AI (Phase 6) ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_DAILY_REQUEST_LIMIT=50
